rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // This app intentionally uses one shared document for the whole signed-in group.
    match /betRecords/shared {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['records', 'updatedAt'])
        && request.resource.data.records is list
        && request.resource.data.records.size() <= 500
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
